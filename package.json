{
  "name": "homebridge-random-delay-switches",
  "version": "1.4.0",
  "private": true,
  "description": "Delay switch with or without a random delay for Homebridge: https://github.com/nfarina/homebridge",
  "keywords": [
    "automation",
    "cron",
    "delay",
    "homebridge-plugin",
    "random",
    "schedule",
    "supports-hap",
    "timer"
  ],
  "homepage": "http://github.com/kernie66/homebridge-random-delay-switches#readme",
  "bugs": {
    "url": "http://github.com/kernie66/homebridge-random-delay-switches/issues"
  },
  "license": "MIT",
  "author": "Kenneth Jagenheim, rewritten from plugin by Simone Karin Lehmann",
  "repository": {
    "type": "git",
    "url": "git://github.com/kernie66/homebridge-random-delay-switches.git"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc",
    "build": "rimraf ./dist && tsc",
    "build:watch": "vp run compile --watch",
    "build:cache": "vp run --cache compile",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:debug": "OXC_LOG=debug vp lint --type-aware",
    "watch": "vp run build && vp link && nodemon",
    "watch:debug": "vp run build && vp link && DEBUG=HAP-NodeJS:* nodemon",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "local-release": "changeset version && changeset publish",
    "release": "changeset publish",
    "prepare": "vp config"
  },
  "dependencies": {
    "cronstrue": "^3.24.0",
    "figlet": "^1.11.4",
    "homebridge-lib": "^8.1.4",
    "node-cron": "^4.6.0",
    "temporal-polyfill": "^1.0.4",
    "tsafe": "^1.8.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.2.0",
    "@voidzero-dev/vite-plus-core": "^0.2.8",
    "@voidzero-dev/vite-plus-test": "^0.1.24",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "homebridge": "^2.3.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsgolint": "^0.0.1",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "homebridge": ">=1.7.0 || ^2.0.0",
    "node": ">=18.16.0"
  },
  "allowScripts": {
    "oxlint-tsgolint": true,
    "fsevents": true
  }
}

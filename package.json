{
  "name": "homebridge-random-delay-switches",
  "version": "1.4.0",
  "description": "Delay switch with or without a random delay for Homebridge: https://github.com/nfarina/homebridge",
  "keywords": [
    "automation",
    "cron",
    "delay",
    "homebridge-plugin",
    "random",
    "schedule",
    "timer"
  ],
  "homepage": "http://github.com/kernie66/homebridge-random-delay-switches#readme",
  "bugs": {
    "url": "http://github.com/kernie66/homebridge-random-delay-switches/issues"
  },
  "license": "MIT",
  "author": "Kenneth Jagenheim, rewritten from plugin by Simone Karin Lehmann",
  "repository": {
    "type": "git",
    "url": "git://github.com/kernie66/homebridge-random-delay-switches.git"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc",
    "build": "rimraf ./dist && tsc",
    "build:watch": "vp run compile --watch",
    "build:cache": "vp run --cache compile",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:debug": "OXC_LOG=debug oxlint --type-aware",
    "watch": "vp run build && vp link && nodemon",
    "test": "vp test run",
    "local-release": "changeset version && changeset publish",
    "release": "changeset publish",
    "prepare": "vp config"
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "cron": "^4.4.0",
    "cronstrue": "^3.24.0",
    "dayjs": "^1.11.21",
    "events": "^3.3.0",
    "homebridge-lib": "^8.1.2",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^1.2.1",
    "@types/node": "^26.1.0",
    "@voidzero-dev/vite-plus-core": "^0.2.4",
    "@voidzero-dev/vite-plus-test": "^0.1.24",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "homebridge": "^2.1.0",
    "nodemon": "^3.1.14",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsgolint": "^0.0.1",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core",
    "vitest": "npm:@voidzero-dev/vite-plus-test"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "homebridge": ">=1.7.0 || ^2.0.0",
    "node": ">=18.16.0"
  }
}
